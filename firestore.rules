rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    // Check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the owner of the resource (by ID matching UID)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is listed in the 'collaborators' array of the document
    function isCollaborator(resourceData) {
      return isAuthenticated()
        && resourceData.collaborators != null
        && (request.auth.uid in resourceData.collaborators);
    }

    // Check if the user is a collaborator on the PARENT trip
    // Note: This requires a get() call which costs 1 read. 
    function isParentTripCollaborator(appId, tripId) {
      let tripData = get(/databases/$(database)/documents/artifacts/$(appId)/trips/$(tripId)).data;
      return isAuthenticated() && (request.auth.uid in tripData.collaborators);
    }

    // Check if the parent trip is active (not completed)
    function isTripActive(appId, tripId) {
      let tripData = get(/databases/$(database)/documents/artifacts/$(appId)/trips/$(tripId)).data;
      return !('isCompleted' in tripData) || tripData.isCompleted != true;
    }

    // --- Rules ---

    // 1. User Profiles
    // Path: artifacts/{appId}/users/{userId}
    match /artifacts/{appId}/users/{userId} {
      // Read: Authenticated users can read profiles (to find people to invite)
      // We might want to restrict this further later (e.g. strict ID lookup only), 
      // but for "Searching" users, open read for auth users is common.
      allow read: if isOwner(userId);
      
      // Write: Only the owner can edit their profile
      allow write: if isOwner(userId);
      
      // Sub-collections (notifications, etc)
      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Trips
    // Path: artifacts/{appId}/trips/{tripId}
    match /artifacts/{appId}/trips/{tripId} {
      // Create: Authenticated users can create trips
      // Validation: Must set themselves as owner and distinct in collaborators
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.collaborators.hasAll([request.auth.uid])
                    && request.resource.data.keys().hasOnly([
                        'ownerId', 'collaborators', 'name', 'description',
                        'startDate', 'endDate', 'destination', 'budget',
                        'currency', 'totalCost', 'createdAt', 'updatedAt',
                        'isCompleted'
                      ])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 200
                    && (request.resource.data.budget == null || (request.resource.data.budget is number && request.resource.data.budget >= 0))
                    && (request.resource.data.destination == null || (request.resource.data.destination is string && request.resource.data.destination.size() <= 200));

      // Read: Collaborator
      allow read: if isCollaborator(resource.data);

      // Update: Collaborator AND either the trip is active, OR it is the owner reopening it
      allow update: if isCollaborator(resource.data)
                    && (
                      (!('isCompleted' in resource.data) || resource.data.isCompleted != true)
                      || (request.resource.data.isCompleted == false && request.auth.uid == resource.data.ownerId)
                    );

      // Delete: Owner can delete any time; collaborators can only delete active trips
      allow delete: if isAuthenticated() && (
                      (resource.data.ownerId == request.auth.uid) ||
                      (isCollaborator(resource.data) && (!('isCompleted' in resource.data) || resource.data.isCompleted != true))
                    );
      
      // 3. Trip Sub-collections (Days, Activities)
      // Path: artifacts/{appId}/trips/{tripId}/days/{dayId}
      match /days/{dayId} {
        // Inherit access from parent Trip
        allow read: if isParentTripCollaborator(appId, tripId);
        allow write: if isParentTripCollaborator(appId, tripId) && isTripActive(appId, tripId);
      }
      
      // Path: artifacts/{appId}/trips/{tripId}/activities/{activityId}
      match /activities/{activityId} {
         allow read: if isParentTripCollaborator(appId, tripId);
         allow write: if isParentTripCollaborator(appId, tripId) && isTripActive(appId, tripId);
      }

      // Path: artifacts/{appId}/trips/{tripId}/expenses/{expenseId}
      match /expenses/{expenseId} {
         allow read: if isParentTripCollaborator(appId, tripId);
         allow write: if isParentTripCollaborator(appId, tripId)
           && isTripActive(appId, tripId)
           && request.resource.data.amount is number
           && request.resource.data.amount > 0
           && request.resource.data.amount <= 999999999
           && request.resource.data.category is string
           && request.resource.data.category.size() <= 50
           && request.resource.data.paidBy is string;
      }
    }
    // 4. Feedback
    // Path: feedback/{feedbackId}
    match /feedback/{feedbackId} {
      // Allow anyone (even unauthenticated, if needed, or just auth) to create feedback
      // Since our app supports anonymous feedback via "Report a Bug", let's be permissive strictly for creation.
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['text', 'rating', 'createdAt', 'userId'])
        && request.resource.data.text is string
        && request.resource.data.text.size() < 1000
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5; 
      
      // Only admins/devs should read/delete (restricted for now, or open if you want to build an admin panel later)
      allow read, update, delete: if false; 
    }
  }
}
